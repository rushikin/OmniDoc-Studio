# ── OpenRouter API Key ─────────────────────────────────────────────────────
# Get your FREE key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Default AI Model ───────────────────────────────────────────────────────
# Any model ID from https://openrouter.ai/models (free ones end with :free)
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# ── OCR Settings ──────────────────────────────────────────────────────────
# Language code: en | ch | fr | de | es | ar | ja | ko | ru
OCR_LANGUAGE=en

# ── Output Directory ──────────────────────────────────────────────────────
# Where .docx files are saved. Default is Desktop\Extracted Files.
OUTPUT_DIR=C:\Users\rushi\OneDrive\Desktop\Extracted Files

# ── Logging ───────────────────────────────────────────────────────────────
# Directory for log files. Will be created automatically.
LOG_DIR=./logs
